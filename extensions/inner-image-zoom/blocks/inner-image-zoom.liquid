{% schema %}
{
  "name": "Inner Image Zoom",
  "target": "body",
  "settings": [
    {
      "type": "select",
      "id": "zoom_type",
      "label": "Zoom trigger",
      "options": [
        { "value": "click", "label": "Click" },
        { "value": "hover", "label": "Hover" }
      ],
      "default": "click",
      "info": "For hover zoom, enable preload zoom image for smoother results."
    },
    {
      "type": "select",
      "id": "move_type",
      "label": "Move type",
      "options": [
        { "value": "pan", "label": "Pan (follow cursor)" },
        { "value": "drag", "label": "Drag" }
      ],
      "default": "pan"
    },
    {
      "type": "checkbox",
      "id": "fullscreen_on_mobile",
      "label": "Fullscreen zoom on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_breakpoint",
      "label": "Mobile breakpoint",
      "min": 480,
      "max": 1280,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "zoom_scale",
      "label": "Zoom scale",
      "info": "Controls the zoomed image size. 1 shows 100% full detail while lower values zoom in less (e.g. 0.9 = 90%).",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "hide_hint",
      "label": "Hide zoom hint icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_close_button",
      "label": "Hide close button on mobile",
      "info": "When hidden, tap the zoomed image to zoom out.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "zoom_preload",
      "label": "Preload zoom image",
      "info": "Loads the high-res image in the background so zoom appears instantly. Can slow the first page load.",
      "default": false
    }
  ]
}
{% endschema %}

{{ 'styles.min.css' | asset_url | stylesheet_tag }}
{{ 'iiz-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'inner-image-zoom.min.js' | asset_url }}" defer></script>
<script src="{{ 'iiz-init.js' | asset_url }}" defer></script>

<script>
  window.InnerImageZoomConfig = {
    zoomType: {{ block.settings.zoom_type | json }},
    moveType: {{ block.settings.move_type | json }},
    fullscreenOnMobile: {{ block.settings.fullscreen_on_mobile | json }},
    mobileBreakpoint: {{ block.settings.mobile_breakpoint | json }},
    zoomScale: {{ block.settings.zoom_scale | json }},
    hideHint: {{ block.settings.hide_hint | json }},
    hideCloseButton: {{ block.settings.hide_close_button | json }},
    zoomPreload: {{ block.settings.zoom_preload | json }}
  };
</script>